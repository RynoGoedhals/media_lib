with "config/media_lib_config.gpr";
project Media_Lib is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Media_Lib_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("media_lib.adb");

   package Compiler is
      for Default_Switches ("Ada") use Media_Lib_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Media_Lib;
